---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Photos from '../components/Photos.astro';
import hero from '../assets/gallery/burgundy-straight.webp';
import { faqs, prose } from '../data/copy.js';
import { reviews } from '../data/reviews.js';
import { formatMinutes, hoursRows, services } from '../data/salon.js';
import { sitePath } from '../lib/paths.js';

const hours = hoursRows();
const topReviews = reviews.slice(0, 3);
const description =
  "Gab's hair room is a hair salon at 30 Leicester Close, Kettering. Book a cut, colour, highlights, balayage, perm, or keratin treatment. Customer parking on site.";
---
<Base
  title="Hairdresser in Kettering"
  description={description}
  path="/"
  faqs={faqs}
>
  <Header path="/">
    <section class="hero">
      <p class="scribble">Kettering</p>
      <h1>
        <span>Gab's</span>
        <span>hair</span>
        <span>room</span>
      </h1>
      <p class="hero-copy">
        One chair on Leicester Close. Cuts, colour, and a calm hour. Customer parking by the fence.
      </p>
      <figure class="hero-photo">
        <Image
          src={hero}
          alt="Straight burgundy hair, cut blunt around the shoulders, in Gab's salon in Kettering."
          widths={[480, 800, 1200]}
          sizes="(max-width: 860px) 100vw, 42vw"
          loading="eager"
          fetchpriority="high"
        />
        <svg class="smile" viewBox="0 0 64 64" aria-hidden="true">
          <circle cx="32" cy="32" r="22" fill="none" stroke="#4dff6e" stroke-width="3"></circle>
          <circle cx="24" cy="27" r="2.4" fill="#4dff6e"></circle>
          <circle cx="40" cy="27" r="2.4" fill="#4dff6e"></circle>
          <path d="M22 36c3.5 6 16.5 6 20 0" fill="none" stroke="#4dff6e" stroke-width="3" stroke-linecap="round"></path>
        </svg>
      </figure>
      <a class="badge" href={sitePath('/book')}>
        <svg viewBox="0 0 140 140" role="img" aria-label="Book now">
          <path fill="#4dff6e" d="M70.0 12.0 L85.8 21.5 L104.1 23.1 L111.3 40.0 L125.2 52.1 L121.0 70.0 L125.2 87.9 L111.3 100.0 L104.1 116.9 L85.8 118.5 L70.0 128.0 L54.2 118.5 L35.9 116.9 L28.7 100.0 L14.8 87.9 L19.0 70.0 L14.8 52.1 L28.7 40.0 L35.9 23.1 L54.2 21.5 L70.0 12.0 Z"></path>
          <text x="70" y="74" text-anchor="middle" fill="#08210e">BOOK NOW</text>
        </svg>
      </a>
    </section>
  </Header>

  <div class="sheet prose">
    <h2>Kettering hair, done by Gabi.</h2>
    <p>{prose.homeLead}</p>
    <p>{prose.homeNext}</p>
    <p>{prose.homeHours}</p>
    <div class="actions">
      <a class="button" href={sitePath('/book')}>Book a time</a>
      <a class="button ghost" href={sitePath('/services')}>See the services</a>
    </div>

    <Photos files={['teal-curls', 'tinsel-braid', 'parking-sign']} />

    <h2>Services</h2>
    <div class="grid-3">
      {services.map((service) => (
        <article class="card">
          <h3>{service.name}</h3>
          <p>{service.summary}</p>
          <p class="meta">Chair held for {formatMinutes(service.minutes)}.</p>
          <p class="price-tag">Pay in the salon</p>
        </article>
      ))}
    </div>

    <h2>What clients wrote</h2>
    <div class="review-list">
      {topReviews.map((review) => (
        <article class="review">
          <p class="stars" aria-label="5 stars">★★★★★</p>
          <h3>{review.name}</h3>
          <p>{review.text}</p>
        </article>
      ))}
    </div>
    <p><a href={sitePath('/reviews')}>Read all the written reviews</a></p>

    <h2>Hours</h2>
    <div class="hours">
      {hours.map((row) => (
        <div>
          <span>{row.name}</span>
          <span class={row.closed ? 'closed' : ''}>{row.text}</span>
        </div>
      ))}
    </div>

    <h2>Questions</h2>
    <div class="faq">
      {faqs.map((faq) => (
        <details>
          <summary>{faq.q}</summary>
          <p>{faq.a}</p>
        </details>
      ))}
    </div>
  </div>
</Base>
