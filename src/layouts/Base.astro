---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import { salon } from '../data/salon.js';
import { absoluteUrl, sitePath } from '../lib/paths.js';
import { breadcrumbSchema, faqSchema, hairSalonSchema } from '../lib/schema.js';

const {
  title,
  description,
  path = '/',
  crumbs = [],
  faqs = null,
} = Astro.props;

const origin = absoluteUrl('/', Astro.site).replace(/\/$/, '');
const canonical = absoluteUrl(path, Astro.site);
const og = absoluteUrl('/og.webp', Astro.site);
const fullTitle = title.includes(salon.name) ? title : `${title} | ${salon.name}`;
const graphs = [
  hairSalonSchema(origin),
  breadcrumbSchema(origin, [{ name: 'Home', path: '/' }, ...crumbs]),
];
if (faqs) graphs.push(faqSchema(faqs));
const json = JSON.stringify(graphs.length === 1 ? graphs[0] : graphs).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={sitePath('/favicon.svg')} type="image/svg+xml" />
    <meta name="theme-color" content="#070707" />
    <meta name="geo.region" content="GB-NTH" />
    <meta name="geo.placename" content="Kettering" />
    <meta name="geo.position" content={`${salon.lat};${salon.lng}`} />
    <meta name="ICBM" content={`${salon.lat}, ${salon.lng}`} />
    <meta property="og:type" content="business.business" />
    <meta property="og:site_name" content={salon.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    <script type="application/ld+json" set:html={json} />
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <div class="noise" aria-hidden="true"></div>
    <p class="bg-word" aria-hidden="true">NN16</p>
    <svg class="bg-smile" viewBox="0 0 64 64" aria-hidden="true">
      <circle cx="32" cy="32" r="22" fill="none" stroke="#4dff6e" stroke-width="2"></circle>
      <circle cx="24" cy="28" r="2" fill="#4dff6e"></circle>
      <circle cx="40" cy="28" r="2" fill="#4dff6e"></circle>
      <path d="M22 36c3.5 6 16.5 6 20 0" fill="none" stroke="#4dff6e" stroke-width="2" stroke-linecap="round"></path>
    </svg>
    <div class="shell">
      <main id="content">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
